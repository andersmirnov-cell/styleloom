{% macro testimonialItems(items, class = "") %}
	{% set classes = ["testimonial__item", class] | select("truthy") | join(" ") %}

	{% for item in items %}
		<article class="{{ classes }}">
			<header class="testimonial__author">
				<img src="{{ item.avatar }}" alt="Photo of {{ item.name }}" loading="lazy" class="testimonial__avatar" />
				<div class="testimonial__author-info">
					<h3 class="testimonial__name">{{ item.name }}</h3>
					<p class="testimonial__location">{{ item.location }}</p>
				</div>
				<a href="#" class="testimonial__social">
					<img src="/src/assets/images/icon-twitter.svg" alt="" loading="lazy" />
					<span class="sr-only">{{ item.name }} on Twitter</span>
				</a>
			</header>
			<img src="/src/assets/images/icon-rating-5-stars.svg" alt="Rated 5 out of 5" loading="lazy" class="testimonial__rating" />
			<blockquote class="testimonial__text">
				<p>{{ item.text }}</p>
			</blockquote>
		</article>
	{% endfor %}
{% endmacro %}

<section class="testimonial">
	<div class="container">
		<header class="testimonial__header">
			<h2>The StyleLoom Testimonial Collection.</h2>
			<p>At StyleLoom, our customers are the heartbeat of our brand.</p>
		</header>
		<div class="testimonial__grid">
			<div class="holder">
				{{ testimonialItems(testimonials) }}
				{{ button(class = "", loadMore = true, text = "View All", moreText = "View All", lessText = "Hide", icon = "/src/assets/images/icon-arrow-down.svg") }}
			</div>
		</div>
	</div>
</section>
