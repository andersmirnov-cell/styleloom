{% macro gridItem(items, class = "") %}
	{% set classes = ["latest-collection__item", class] | select("truthy") | join(" ") %}

	{% for item in items %}
		<article class="{{ classes }}">
			<picture class="latest-collection__picture">
				<source
					srcset="{{ item.imageUrlDesktopLg }}"
					media="(min-width: {{ breakpoints.xxl }}px)"
				/>
				<source
					srcset="{{ item.imageUrlDesktop }}"
					media="(min-width: {{ breakpoints.md }}px)"
				/>
				<img src="{{ item.imageUrl }}" alt="{{ item.imageAlt }}" loading="lazy" class="latest-collection__image" />
			</picture>
			<div class="latest-collection__tags">
				{% for tag in item.tags %}
					{{ button(text = tag, href = "#", class = "btn--secondary" ) }}
				{% endfor %}
			</div>
			<div class="latest-collection__title-area">
				<h3 class="latest-collection__title">{{ item.title }}</h3>
				<dl class="latest-collection__meta">
					<dt>Fit</dt>
					<dd>{{ item.fit }}</dd>
					<dt>Price</dt>
					<dd>{{ item.price }}</dd>
				</dl>
			</div>
			{{ button(text = "Shop Now", href = "#", class = "btn--secondary bordered-corners latest-collection__btn", icon = "/src/assets/images/icon-arrow-up-right.svg" ) }}
		</article>
	{% endfor %}
{% endmacro %}

<section class="latest-collection">
	<div class="container">
		<header class="latest-collection__header">
			<h2>Elevate Your Style with Our Latest Collection</h2>
			<p>Each piece is crafted to enhance your fashion statement.</p>
			{{ menuButtonsSecondary(menuItems) }}
		</header>
		<div class="latest-collection__grid">
			<div class="holder">
				{{ gridItem(gridItems) }}
				{{ button(class = "", loadMore = true, text = "View All", moreText = "View All", lessText = "Hide", icon = "/src/assets/images/icon-arrow-down.svg") }}
			</div>
		</div>
	</div>
</section>
